{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "FIREBASE-SETUP.md",
      "firestore.rules",
      "storage.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key":"Cache-Control","value":"public,max-age=3600"}]
      }
    ]
  },
  "firestore": {"rules": "firestore.rules"},
  "storage": {"rules": "storage.rules"}
}
