rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /members/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Fixed master list used by the UI. The application does not write this
    // collection; department names are locked in the app.
    match /departments/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ideas/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /cycles/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /projects/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /progress/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /activity_logs/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
