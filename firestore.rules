rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // Main collections only accept the compact fields used by the app.
    function validMember() { return request.resource.data.keys().hasOnly(['n','r','a','o','c','u']); }
    function validIdea() { return request.resource.data.keys().hasOnly(['n','s','d','p','i','b','q','t','x','f','c','u']); }
    function validCycle() { return request.resource.data.keys().hasOnly(['l','s','e','x','c','u']); }
    function validProject() { return request.resource.data.keys().hasOnly(['c','i','n','t','o','s','e','p','x','g','z','u']); }
    function validProgress() { return request.resource.data.keys().hasOnly(['p','m','d','w','r','b','n','v','f','c','u']); }

    match /members/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && validMember(); allow delete: if isSignedIn(); }
    match /departments/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && request.resource.data.keys().hasOnly(['n','a','o','c','u']); allow delete: if isSignedIn(); }
    match /ideas/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && validIdea(); allow delete: if isSignedIn(); }
    match /cycles/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && validCycle(); allow delete: if isSignedIn(); }
    match /projects/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && validProject(); allow delete: if isSignedIn(); }
    match /progress/{document=**} { allow read: if isSignedIn(); allow create, update: if isSignedIn() && validProgress(); allow delete: if isSignedIn(); }

    // Retained for backward compatibility with earlier workbook builds.
    match /excel_sheets/{sheetId} { allow read, create, update, delete: if isSignedIn(); }
    match /app_meta/{document=**} { allow read, write: if isSignedIn(); }
    match /master_sheet/{rowId} { allow read, create, update, delete: if isSignedIn(); }

    match /team_chat/{messageId} {
      allow read, create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /notifications/{document=**} { allow read, write: if isSignedIn(); }

    // Minute-level managed-device usage; collection is isolated from R&D work records.
    match /usage_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['m','n','v','d','s','e','a','p','h','x','i','q','u'])
        && request.resource.data.m is int
        && request.resource.data.v is string
        && request.resource.data.d is string
        && request.resource.data.s is int
        && request.resource.data.e is int
        && request.resource.data.x is int
        && request.resource.data.i is int;
      allow delete: if false;
    }

    // Lightweight recovery copies created before destructive deletes.
    match /activity_logs/{document=**} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
